# =================================================================
# === FILE: .env (CẤU HÌNH CHO MÔI TRƯỜNG PHÁT TRIỂN CỤC BỘ) ===
# === KHÔNG BAO GIỜ ĐƯỢC ĐẨY FILE NÀY LÊN GITHUB               ===
# =================================================================

# 1. THÔNG TIN DATABASE (POSTGRESQL LOCALHOST/DOCKER)
# Sử dụng các biến này khi NODE_ENV != production
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_NAME=cms-database
DB_PASSWORD="Slayer123!"

# 2. CẤU HÌNH SERVER VÀ BẢO MẬT
# Khóa bí mật cho Express Session. Cần một chuỗi ngẫu nhiên, mạnh.
SESSION_SECRET="k@j2k25"

# 3. MÔI TRƯỜNG ỨNG DỤNG
# Thiết lập môi trường phát triển (development)
# (Trên Render, bạn phải thiết lập biến này là 'production')
NODE_ENV="development"

# 4. CẤU HÌNH LƯU TRỮ FILE (CHO MỤC ĐÍCH PHÁT TRIỂN)
# Mặc dù chúng ta đang dùng Multer lưu cục bộ, biến này có thể hữu ích
# nếu bạn chuyển sang dịch vụ khác sau này.
# Giá trị: 'LOCAL' (lưu trên máy chủ)
FILE_STORAGE_MODE="LOCAL"